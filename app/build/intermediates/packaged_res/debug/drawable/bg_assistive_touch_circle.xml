<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lingkaran Luar Gelap Transparan -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#B31C1C1E" />
            <stroke
                android:width="1.5dp"
                android:color="#40FFFFFF" />
            <size
                android:width="60dp"
                android:height="60dp" />
        </shape>
    </item>
    <!-- Lingkaran Putih di Tengah -->
    <item
        android:bottom="14dp"
        android:left="14dp"
        android:right="14dp"
        android:top="14dp">
        <shape android:shape="oval">
            <solid android:color="#E6FFFFFF" />
        </shape>
    </item>
</layer-list>